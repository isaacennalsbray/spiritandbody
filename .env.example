PORT=3001
JWT_SECRET=replace_with_random_256bit_string
# Postgres connection string. Locally, point this at any Postgres instance.
# On Vercel, add the "Postgres" storage integration (Storage tab -> Create
# Database -> Postgres) and it auto-populates POSTGRES_URL for you.
POSTGRES_URL=postgres://user:password@localhost:5432/spiritandbody
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
